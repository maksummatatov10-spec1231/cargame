; Engine configuration file.
; Generated for Godot 4.3 — cargame stage 1

config_version=5

[application]

config/name="CarGame"
config/description="Stage 1 — BMW 1M with raycast suspension, brush tyre model and wheel animation."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

; No frame rate cap by default.
;
; This used to say debug/settings/fps/force_fps=0, which is the *Godot 3*
; setting name. Verified against the 4.3 source: grepping the whole engine
; for "force_fps" returns nothing, while main.cpp:2377 reads
; application/run/max_fps. So the old line was inert - the project had no
; working frame rate control whatsoever, and the value below is the one the
; engine actually honours. It is also overridden at runtime by
; scripts/game_settings.gd from the settings menu.
run/max_fps=0

[debug]

settings/stdout/verbose_stdout=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
; Vsync OFF by default.
;
; The old value was 1 (VSYNC_ENABLED), and that is why the game sat at a low
; fixed number no matter what: with vsync on, the engine never presents faster
; than the display refreshes, so the frame rate is pinned to the refresh rate
; and any max_fps above it does nothing. A 75 Hz monitor showing 60 means
; something below is also capping, but vsync guaranteed you could never see
; more than 75 either way. Off by default, switchable in the settings menu:
;   0 disabled, 1 enabled, 2 adaptive, 3 mailbox (triple buffered).
window/vsync/vsync_mode=0
window/energy_saving/keep_screen_on=true

; No importer_defaults block.
;
; It used to set compress/normal_map = 0 and roughness/mode = 0 for EVERY
; texture, and those are precisely the two values that make
; resource_importer_texture.cpp:110-131 print
;
;   "<file>: текстура используется как карта нормалей в 3D..."
;   "<file>: текстура используется как карта шероховатости в 3D..."
;
; on first open - once per texture - before rewriting the .import itself. So
; the block added to silence those messages was what caused them.
;
; Raising normal_map to 1 project-wide is not the answer either: these
; defaults apply to all 44 textures, and red-green compression discards the
; blue channel, which would wreck the 26 albedo maps.
;
; Instead every texture ships its own .import with the right settings for its
; actual role, generated by tools/make_import_files.py, which reads that role
; out of the glTF rather than guessing from the file name - RIM_OS.png and
; Fanali_Anteriori_OS.png are normal maps despite the _OS suffix.
; editor_file_system.cpp:2435-2459 confirms a per-file .import takes
; precedence, and importer_defaults are only merged when one is absent.

[autoload]

; Loaded before any scene and kept across scene changes, which is what lets
; the pause menu change a video setting that the main menu also edits.
GameSettings="*res://scripts/game_settings.gd"

