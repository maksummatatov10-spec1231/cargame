[input_devices]
pointing/emulate_touch_from_mouse=false

[physics]
common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
3d/default_gravity=9.8
3d/solver/solver_iterations=16

[rendering]
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.52, 0.68, 0.94, 1)
environment/defaults/default_environment="res://scenes/default_env.tres"
textures/vram_compression/import_etc2_astc=true
meshes/lod/lod_change/threshold_pixels=128
