; Engine configuration file.
; Generated for Godot 4.3 — cargame stage 1

config_version=5

[application]

config/name="CarGame"
config/description="Stage 1 — BMW 1M with raycast suspension, brush tyre model and wheel animation."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[debug]

settings/fps/force_fps=0
settings/stdout/verbose_stdout=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1
; Adaptive vsync: tears rather than halving the frame rate if a frame is late,
; which keeps motion smooth on a weaker machine.
window/energy_saving/keep_screen_on=true

[importer_defaults]

; Every texture in this project is a 3D car texture. Without these, Godot
; imports each PNG with 2D defaults, then notices it is used in 3D and imports
; it a second time with mipmaps and VRAM compression - that is the wall of
; "текстура используется в 3D..." messages on first open. Setting the right
; values up front means each texture is imported once, correctly.
texture={
"compress/mode": 2,
"compress/normal_map": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true,
"roughness/mode": 0
}

