[physics]

; 120 Hz is what the tyre model is tuned for. Rendering runs at whatever the
; display does, so the body would visibly step between ticks - that is the
; jerkiness. Godot 4.3 only implements physics interpolation for 2D (checked
; against the engine source: scene/3d/node_3d.cpp has no interpolation code,
; it arrived for 3D in 4.4), so the smoothing is done in scripts/smoothing.gd
; instead. jitter_fix still helps by damping the reported frame delta.
common/physics_ticks_per_second=120
; How many physics ticks a single frame may run.
;
; THIS IS THE "sometimes it drops to 15 fps" BUG, and it was my doing.
;
; main.cpp:4031 clamps the catch-up:
;     if (advance.physics_steps > max_physics_steps) {
;         process_step -= (advance.physics_steps - max_physics_steps) * physics_step;
;         advance.physics_steps = max_physics_steps;
;     }
; so when the game falls behind it replays up to max_physics_steps full
; vehicle ticks inside one frame. Those make that frame long too, which owes
; more ticks, and it saturates - parking the frame rate at exactly
; physics_hz / max_physics_steps and staying there.
;
; At 120 Hz with 8 steps that floor is 120/8 = 15.0 fps. An exact match for
; the reported number, and it explains why it locks at 15 rather than
; wandering around.
;
; I raised this from 4 to 8 in v2.8 to stop simulated time dilating below
; 30 fps, which was a real problem - but it moved the lock-up floor from
; 30 fps down to 15 and made the spiral twice as deep.
;
; 3 puts the floor at 120/3 = 40 fps: the game can no longer lock itself
; below 40, one hitch can only ever cost three ticks of catch-up, and time
; still runs true down to 40 fps. Slower than that and the clock slows
; instead of the game seizing, which is the better failure of the two.
common/max_physics_steps_per_frame=3
common/physics_jitter_fix=0.5
3d/default_gravity=9.81
3d/solver/solver_iterations=24

[rendering]

renderer/rendering_method="forward_plus"
; MSAA 2x rather than 4x: with FXAA also on, the difference is hard to see and
; 4x costs real bandwidth on integrated graphics.
; MSAA off, FXAA on. MSAA resolves the whole framebuffer every frame, which is
; bandwidth this card does not have to spare; FXAA is a cheap post pass.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
; 4096 is indistinguishable from 8192 at this shadow distance and uses a
; quarter of the shadow map memory, which matters on a weak GPU.
lights_and_shadows/directional_shadow/size=4096
; Filter quality 1 is a 2x2 tap instead of a larger kernel; with PCSS off the
; difference outdoors is hard to see.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.42, 0.58, 0.78, 1)
textures/default_filters/anisotropic_filtering_level=2
; Draw the far hills at lower detail; the mesh LOD system handles the rest.
mesh_lod/lod_change/threshold_pixels=2.0
