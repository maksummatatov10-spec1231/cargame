[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.8434, -0.2903, 0.4523, 0, 0.8415, 0.5402, -0.5373, -0.4556, 0.7098, 0, 28, 0)
light_color = Color(1, 0.955, 0.878, 1)
light_energy = 2.6
light_indirect_energy = 1.0
light_specular = 1.0
; PCSS soft shadows (any angular distance above 0) make every shadow lookup
; take multiple samples to find the blocker distance first. On a mid-range GPU
; that is one of the most expensive things in a scene. Fixed-width shadows with
; a small blur read almost the same outdoors at a fraction of the cost.
light_angular_distance = 0.0
shadow_blur = 1.4
shadow_enabled = true
shadow_bias = 0.02
shadow_normal_bias = 1.2
shadow_opacity = 1.0
shadow_blur = 1.0
directional_shadow_mode = 2
directional_shadow_split_1 = 0.04
directional_shadow_split_2 = 0.13
directional_shadow_split_3 = 0.4
directional_shadow_blend_splits = true
directional_shadow_fade_start = 0.92
directional_shadow_max_distance = 190.0
directional_shadow_pancake_size = 25.0

