[sub_resource type="ProceduralSkyMaterial" id="Sky"]
sky_top_color = Color(0.16, 0.35, 0.72, 1)
sky_horizon_color = Color(0.68, 0.78, 0.89, 1)
sky_curve = 0.13
sky_energy_multiplier = 1.0
ground_bottom_color = Color(0.17, 0.19, 0.17, 1)
ground_horizon_color = Color(0.6, 0.67, 0.73, 1)
ground_curve = 0.04
ground_energy_multiplier = 1.0
sun_angle_max = 8.0
sun_curve = 0.05
use_debanding = true

[sub_resource type="Sky" id="SkyRes"]
sky_material = SubResource("Sky")
radiance_size = 4

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("SkyRes")
; Ambient comes from the sky, but at a fraction of full strength. At 1.0 every
; surface is lit from every direction at once, which flattens the car and is a
; large part of why the old scene looked washed out.
ambient_light_source = 3
ambient_light_color = Color(0.5, 0.58, 0.72, 1)
ambient_light_sky_contribution = 0.42
ambient_light_energy = 0.85
reflected_light_source = 2
; ACES gives a filmic highlight roll-off instead of clipping to white. Exposure
; is pulled back and white raised so the sky has somewhere to go.
tonemap_mode = 3
tonemap_exposure = 0.82
tonemap_white = 8.0
; SSAO at half resolution looks the same at this scale and costs about a third
; as much. SSIL is dropped: with SDFGI already providing bounce light it was
; paying twice for the same effect.
ssao_enabled = true
ssao_radius = 1.0
ssao_intensity = 2.4
ssao_power = 1.8
ssao_detail = 0.6
ssao_horizon = 0.06
ssao_light_affect = 0.15
ssao_ao_channel_affect = 0.4
ssil_enabled = false
; Reflections fade out quickly, so a shorter march is invisible but cheaper.
ssr_enabled = true
ssr_max_steps = 24
ssr_fade_in = 0.2
ssr_fade_out = 4.0
ssr_depth_tolerance = 0.4
; SDFGI is the most expensive thing in the scene. Three cascades with a coarser
; cell still lights the area around the car properly - the far hills get their
; light from the sky ambient anyway - and no bounce feedback saves another pass.
sdfgi_enabled = true
sdfgi_use_occlusion = false
sdfgi_bounce_feedback = 0.0
sdfgi_cascades = 3
sdfgi_min_cell_size = 0.4
sdfgi_y_scale = 2
sdfgi_energy = 1.0
glow_enabled = true
glow_normalized = true
glow_intensity = 0.55
glow_strength = 0.9
glow_bloom = 0.02
glow_blend_mode = 1
glow_hdr_threshold = 1.35
glow_hdr_scale = 2.0
; Distance haze only. The previous scene had a 40 m tall fog layer, which meant
; the whole play area sat *inside* it - about 73% of every pixel was fog colour,
; and that is what bleached the image out. Height fog is off, the density is an
; order of magnitude lower, and aerial perspective ties the far ground into the
; sky the way real atmosphere does.
fog_enabled = true
fog_mode = 0
fog_light_color = Color(0.62, 0.72, 0.86, 1)
fog_light_energy = 0.85
fog_sun_scatter = 0.32
fog_density = 0.0022
fog_aerial_perspective = 0.55
fog_sky_affect = 0.0
fog_height = -80.0
fog_height_density = 0.0
adjustment_enabled = true
adjustment_brightness = 1.0
adjustment_contrast = 1.18
adjustment_saturation = 1.22

